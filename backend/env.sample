# LINE Developers コンソールで発行される値
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# アップロード先のGCSバケット名（事前に作成しておく）
GCS_BUCKET_NAME=

# Google AI Studio で発行するGemini APIキー（MVPはVertex AIではなくAI Studio経由でスピード優先）
GEMINI_API_KEY=

# 駅すぱあとAPIのアクセスキー（最寄り駅・経路検索。未設定でも起動はでき、経路なしで返信する）
EKISPERT_API_ACCESS_KEY=

# ローカル実行時のみ。Cloud Run上ではアタッチされたサービスアカウントのADCを使うため不要
# GOOGLE_APPLICATION_CREDENTIALS=

# Firestore（animalMaster等）接続先のGCPプロジェクトID
GOOGLE_CLOUD_PROJECT=kaiyukan-gacha-hackathon

# /auth/line（LIFFのIDトークン検証→Firebaseカスタムトークン発行）の設定。カンマ区切り。
# 許可するLINEチャネルID（LINEミニアプリのDeveloping / Published）
LINE_LOGIN_CHANNEL_IDS=2011666396,2011666398
# CORSで許可するオリジン（Firebase Hostingの開発・本番サイト）
AUTH_ALLOWED_ORIGINS=https://kaiyukan-gacha-dev.web.app,https://kaiyukan-gacha-hackathon.web.app

PORT=8080
